# App
ENVIRONMENT=development

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the service_role key for loaders / privileged API (server-side only, never ship to frontend)
SUPABASE_SERVICE_KEY=your-service-role-key
# Anon (public) key — used for auth sign-up / sign-in
SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API > JWT Settings > JWT Secret (verifies access tokens)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Embedding + generation models
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GENERATION_MODEL=gemini-1.5-flash

# Loader limits (keep small for a hackathon demo)
NEPOC_CLAIM_GROUPS=10
MISDETECT_ROWS_PER_DOMAIN=5
CHHATRAMANI_ROOT_CLAIMS=25
VARIANTS_PER_ROOT=6

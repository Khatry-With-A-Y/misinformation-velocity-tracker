# App
ENVIRONMENT=development

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the service_role key for loaders / privileged API (server-side only, never ship to frontend)
SUPABASE_SERVICE_KEY=your-service-role-key
# Anon (public) key — used for auth sign-up / sign-in
SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API > JWT Settings > JWT Secret (verifies access tokens)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Embedding + generation models
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GENERATION_MODEL=gemini-1.5-flash

# Authenticated claim ingestion
CLAIM_MATCH_THRESHOLD=0.85
CLAIM_MATCH_WINDOW_DAYS=3650
CLAIM_RATE_LIMIT=10
CLAIM_RATE_WINDOW_MINUTES=60

# News ingestion (RSS) — direct publisher feeds only (JSON object: name -> url)
NEWS_FEEDS={"The Kathmandu Post": "https://kathmandupost.com/rss", "OnlineKhabar English": "https://english.onlinekhabar.com/feed"}
NEWS_MAX_ITEMS_PER_POLL=10
NEWS_AI_FLAG_THRESHOLD=0.75
NEWS_POLL_INTERVAL_MINUTES=60
NEWS_POLL_STARTUP_DELAY_SECONDS=15
NEWS_POLL_LEASE_SECONDS=1800
NEWS_POLL_BACKOFF_BASE_SECONDS=60
NEWS_POLL_BACKOFF_MAX_SECONDS=3600
NEWS_POLL_JITTER_SECONDS=15
# Shared secret for POST /api/news/poll (X-Admin-Token header). Empty = endpoint disabled (503).
NEWS_ADMIN_TOKEN=

# Loader limits (keep small for a hackathon demo)
NEPOC_CLAIM_GROUPS=10
MISDETECT_ROWS_PER_DOMAIN=5
CHHATRAMANI_ROOT_CLAIMS=25
VARIANTS_PER_ROOT=6
